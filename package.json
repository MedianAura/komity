{
  "name": "@medianaura/komity",
  "version": "0.2.0",
  "repository": "https://github.com/MedianAura/komity",
  "license": "MIT",
  "author": "MedianAura",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "main": "dist/entry.js",
  "types": "dist/entry.d.ts",
  "bin": {
    "komity": "./bin/run.js"
  },
  "files": [
    "./bin",
    "./dist"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -p tsconfig.build.json",
    "check": "concatenate check",
    "check:knip": "knip",
    "check:stryker": "stryker run",
    "fix": "concatenate fix",
    "release": "automaton version",
    "start": "cross-env NODE_ENV=development node ./bin/run.js",
    "test:coverage": "open-cli coverage/lcov-report/index.html",
    "test:unit": "vitest --coverage.enabled --coverage.all --coverage.reporter=lcov",
    "test:unit:coverage": "vitest --reporter basic --reporter junit --outputFile.junit=junit.xml --coverage.enabled --coverage.reporter=text-summary --coverage.reporter=cobertura --coverage.reporter=lcov --watch=false",
    "watch": "shx rm -rf dist && tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@medianaura/di-manager": "^1.0.4",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "dotenv-flow": "^4.1.0",
    "env-paths": "^4.0.0",
    "execa": "^10.0.0",
    "fs-extra": "^11.4.0",
    "gitlog2": "^5.0.35",
    "inquirer": "^14.0.2",
    "lodash-es": "^4.18.1",
    "log-update": "^8.0.0",
    "longest": "^2.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "sprintf-js": "^1.1.3",
    "tsyringe": "^4.10.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@medianaura/automaton": "^0.2.0",
    "@medianaura/concatenate": "^0.3.2",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/sprintf-js": "^1.1.4",
    "@types/update-notifier": "^6.0.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-pretty": "^7.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.6",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
