# Les scripts passent par l'émulateur de shell de pnpm plutôt que par cmd.exe.
#
# `test:coverage` lance le rapport via open-cli, qui délègue à `Start-Process`
# dans un powershell détaché. Sous cmd.exe, pnpm démonte l'arbre de processus du
# script à sa sortie et emporte ce powershell avant que Windows n'ait fini de
# passer le fichier au navigateur : la commande rend 0, et rien ne s'ouvre.
# `open` écrit sur un stdio ignoré, donc l'échec est parfaitement silencieux.
#
# L'émulateur exécute la ligne lui-même, sans cmd.exe intermédiaire. Les scripts
# du dépôt sont déjà en syntaxe POSIX (`&&`, `shx`, `cross-env`) : ils y tournent
# à l'identique.
shell-emulator=true
